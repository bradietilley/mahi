    "commander": "^12.1.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "author": "Bradie Tilley",
  "homepage": "https://github.com/bradietilley/mahi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bradietilley/mahi.git",
    "directory": "framework/schedule"
